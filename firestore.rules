rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 30 &&
             data.selectedSkinId is string && data.selectedSkinId.size() >= 1 && data.selectedSkinId.size() <= 30 &&
             data.bestPercentage is number && data.bestPercentage >= 0.0 && data.bestPercentage <= 100.0 &&
             data.totalKills is int && data.totalKills >= 0 && data.totalKills <= 1000000 &&
             data.wins is int && data.wins >= 0 && data.wins <= 1000000 &&
             data.matchesPlayed is int && data.matchesPlayed >= 0 && data.matchesPlayed <= 1000000 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidRoom(data) {
      return data.hostId is string && data.hostId.size() >= 1 && data.hostId.size() <= 128 &&
             data.roomCode is string && data.roomCode.size() >= 4 && data.roomCode.size() <= 16 &&
             data.isPrivate is bool &&
             data.status in ['waiting', 'playing', 'finished'] &&
             data.maxPlayers is int && data.maxPlayers >= 2 && data.maxPlayers <= 8 &&
             data.fillWithBots is bool &&
             data.playerUids is list && data.playerUids.size() >= 0 && data.playerUids.size() <= 8 &&
             (data.playerUids.size() == 0 || data.playerUids[0] is string) &&
             data.playerProfiles is list && data.playerProfiles.size() >= 0 && data.playerProfiles.size() <= 8 &&
             (data.playerProfiles.size() == 0 || data.playerProfiles[0] is string) &&
             (!('winnerUid' in data) || data.winnerUid == null || (data.winnerUid is string && data.winnerUid.size() <= 128)) &&
             (!('winnerName' in data) || data.winnerName == null || (data.winnerName is string && data.winnerName.size() <= 40)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidRoomPlayer(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 30 &&
             data.skinId is string && data.skinId.size() >= 1 && data.skinId.size() <= 30 &&
             data.colorIndex is int && data.colorIndex >= 0 && data.colorIndex <= 15 &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 8 &&
             data.memberUids[0] is string &&
             data.x is number && data.x >= 0.0 && data.x <= 4000.0 &&
             data.y is number && data.y >= 0.0 && data.y <= 4000.0 &&
             data.angle is number && data.angle >= -10.0 && data.angle <= 10.0 &&
             data.percentage is number && data.percentage >= 0.0 && data.percentage <= 100.0 &&
             data.kills is int && data.kills >= 0 && data.kills <= 999 &&
             data.alive is bool &&
             data.trailPacked is string && data.trailPacked.size() <= 12000 &&
             data.territoryPacked is string && data.territoryPacked.size() <= 60000 &&
             (!('claimedKillUid' in data) || data.claimedKillUid == null || (data.claimedKillUid is string && data.claimedKillUid.size() <= 128)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isRoomJoinAction() {
      return existing().status == 'waiting' &&
             !(request.auth.uid in existing().playerUids) &&
             request.auth.uid in incoming().playerUids &&
             incoming().playerUids.size() == existing().playerUids.size() + 1 &&
             incoming().playerUids.size() <= existing().maxPlayers &&
             incoming().playerProfiles.size() == incoming().playerUids.size() &&
             incoming().diff(existing()).affectedKeys().hasOnly(['playerUids', 'playerProfiles', 'updatedAt']);
    }

    function isRoomLeaveAction() {
      return request.auth.uid in existing().playerUids &&
             !(request.auth.uid in incoming().playerUids) &&
             incoming().playerUids.size() == existing().playerUids.size() - 1 &&
             incoming().playerProfiles.size() == incoming().playerUids.size() &&
             incoming().diff(existing()).affectedKeys().hasOnly(['playerUids', 'playerProfiles', 'updatedAt']);
    }

    function isRoomHostUpdateAction() {
      return existing().hostId == request.auth.uid &&
             existing().status == 'waiting' &&
             (incoming().status == 'waiting' || incoming().status == 'playing') &&
             incoming().diff(existing()).affectedKeys().hasOnly(['status', 'fillWithBots', 'updatedAt']);
    }

    function isRoomFinishAction() {
      return request.auth.uid in existing().playerUids &&
             existing().status == 'playing' &&
             incoming().status == 'finished' &&
             incoming().diff(existing()).affectedKeys().hasOnly(['status', 'winnerUid', 'winnerName', 'updatedAt']);
    }

    match /users/{userId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'selectedSkinId', 'bestPercentage', 'totalKills', 'wins', 'matchesPlayed', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'selectedSkinId', 'bestPercentage', 'totalKills', 'wins', 'matchesPlayed', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'selectedSkinId', 'bestPercentage', 'totalKills', 'wins', 'matchesPlayed', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    match /rooms/{roomId} {
      allow get: if isSignedIn() &&
                    isValidId(roomId) &&
                    (existing().isPrivate == false ||
                     existing().status == 'waiting' ||
                     request.auth.uid in existing().playerUids);

      allow list: if isSignedIn() &&
                     ((existing().isPrivate == false && existing().status == 'waiting') ||
                      (request.auth.uid in existing().playerUids));

      allow create: if isSignedIn() &&
                       isValidId(roomId) &&
                       incoming().hostId == request.auth.uid &&
                       incoming().status == 'waiting' &&
                       incoming().playerUids.size() == 1 &&
                       incoming().playerUids[0] == request.auth.uid &&
                       incoming().playerProfiles.size() == 1 &&
                       incoming().keys().hasAll(['hostId', 'roomCode', 'isPrivate', 'status', 'maxPlayers', 'fillWithBots', 'playerUids', 'playerProfiles', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['hostId', 'roomCode', 'isPrivate', 'status', 'maxPlayers', 'fillWithBots', 'playerUids', 'playerProfiles', 'winnerUid', 'winnerName', 'createdAt', 'updatedAt']) &&
                       isValidRoom(incoming());

      allow update: if isSignedIn() &&
                       isValidId(roomId) &&
                       isValidRoom(incoming()) &&
                       existing().status != 'finished' &&
                       incoming().hostId == existing().hostId &&
                       incoming().roomCode == existing().roomCode &&
                       incoming().isPrivate == existing().isPrivate &&
                       incoming().maxPlayers == existing().maxPlayers &&
                       incoming().createdAt == existing().createdAt &&
                       (isRoomJoinAction() || isRoomLeaveAction() || isRoomHostUpdateAction() || isRoomFinishAction());

      allow delete: if isSignedIn() && isValidId(roomId) && existing().hostId == request.auth.uid;

      match /players/{playerId} {
        allow get: if isSignedIn() &&
                      isValidId(roomId) &&
                      isValidId(playerId) &&
                      request.auth.uid in existing().memberUids;

        allow list: if isSignedIn() &&
                       request.auth.uid in existing().memberUids;

        allow create: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(playerId) &&
                         playerId == request.auth.uid &&
                         incoming().userId == request.auth.uid &&
                         incoming().roomId == roomId &&
                         request.auth.uid in incoming().memberUids &&
                         incoming().keys().hasAll(['userId', 'roomId', 'displayName', 'skinId', 'colorIndex', 'memberUids', 'x', 'y', 'angle', 'percentage', 'kills', 'alive', 'trailPacked', 'territoryPacked', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'roomId', 'displayName', 'skinId', 'colorIndex', 'memberUids', 'x', 'y', 'angle', 'percentage', 'kills', 'alive', 'trailPacked', 'territoryPacked', 'claimedKillUid', 'createdAt', 'updatedAt']) &&
                         isValidRoomPlayer(incoming()) &&
                         exists(/databases/$(database)/documents/rooms/$(roomId)) &&
                         request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.playerUids;

        allow update: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(playerId) &&
                         playerId == request.auth.uid &&
                         existing().userId == request.auth.uid &&
                         isValidRoomPlayer(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().roomId == existing().roomId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['x', 'y', 'angle', 'percentage', 'kills', 'alive', 'trailPacked', 'territoryPacked', 'claimedKillUid', 'memberUids', 'updatedAt']);

        allow delete: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(playerId) &&
                         playerId == request.auth.uid;
      }
    }
  }
}
